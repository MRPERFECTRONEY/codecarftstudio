# Required for production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=your-admin-email@example.com
# Generate with: node -e "import('./server/auth.js').then(m=>console.log(m.createPasswordHash('YOUR_STRONG_PASSWORD')))"
ADMIN_PASSWORD_HASH=salt:64-character-scrypt-hash

# Optional email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=\nSMTP_SECURE=false\nAGENCY_EMAIL=admin@example.com
